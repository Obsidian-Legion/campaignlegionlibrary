-- Unison owns the document, accessible controls, and page composition.
-- CSS and a small browser enhancement provide the cinematic presentation.
use Text ++

campaign.escape : Text -> Text
campaign.escape value =
  value
    |> Text.replaceAll "&" "&amp;"
    |> Text.replaceAll "<" "&lt;"
    |> Text.replaceAll ">" "&gt;"
    |> Text.replaceAll "\"" "&quot;"

campaign.head : Text -> Text -> Text -> Text
campaign.head title description pageClass =
  """
  <!doctype html>
  <html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#000000">
    <title>{{title}}</title>
    <meta name="description" content="{{description}}">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{description}}">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://obsidian-legion.github.io/campaignlegionlibrary/assets/gronlid-library-banner.png">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="styles.css?v=campaign-7">
    <script src="site.js?v=campaign-5" defer></script>
  </head>
  <body class="{{pageClass}}">
    <a class="skip-link" href="#campaign">Skip to content</a>
    <canvas id="embers" aria-hidden="true"></canvas>
    <div class="ambient" aria-hidden="true"></div>
    <div class="edge edge-left" aria-hidden="true"></div>
    <div class="edge edge-right" aria-hidden="true"></div>
  """
    |> Text.replaceAll "{{title}}" (campaign.escape title)
    |> Text.replaceAll "{{description}}" (campaign.escape description)
    |> Text.replaceAll "{{pageClass}}" (campaign.escape pageClass)

campaign.header : Text
campaign.header =
  """
  <header class="campaign-masthead" aria-label="Obsidian Legion sponsored campaign for Gronlid Public Library">
    <div class="campaign-banner">
      <div class="banner-art">
        <img src="assets/gronlid-library-banner.png" alt="Obsidian Legion sponsored campaign — Gronlid Public Library, Gronlid, Saskatchewan, Canada" width="2172" height="724" fetchpriority="high">
        <div class="banner-shine" aria-hidden="true"></div>
      </div>
    </div>
    <div class="cinema" id="cinema">
      <div class="crest-halo" aria-hidden="true"></div>
      <div class="video-shell">
        <video id="legion-film" class="legion-film" muted playsinline preload="auto" poster="assets/legion-poster.jpg" aria-label="Animated Obsidian Legion eagle crest, with outstretched wings, smoke, and red lightning">
          <source src="assets/legion-intro.mp4" type="video/mp4">
        </video>
        <span class="cinema-vignette" aria-hidden="true"></span>
      </div>
      <div class="intro-caption" aria-hidden="true"><span></span> OBSIDIAN LEGION PRESENTS <span></span></div>
      <button class="skip-intro" id="skip-intro" type="button" hidden>Skip intro <span aria-hidden="true">↗</span></button>
      <div class="intro-progress" aria-hidden="true"><span></span></div>
    </div>
    <div class="banner-rule" aria-hidden="true"><span></span><i></i><span></span></div>
  </header>
  """

campaign.stage : Text
campaign.stage =
  """
  <main id="campaign" class="opening-main" tabindex="-1">
    <h1 class="sr-only">Gronlid Public Library — Obsidian Legion campaign</h1>
    <section class="hosting-feature" aria-labelledby="hosting-title">
      <p class="chapter-eyebrow hosting-eyebrow">OUR HOSTING SPONSOR</p>
      <h2 id="hosting-title" class="sr-only">Obsidian Princess</h2>
      <a class="hosting-badge" href="assets/sponsors/obsidianprincess.png" target="_blank" rel="noopener" aria-label="View Obsidian Princess hosting sponsor badge at full size (opens in a new tab)">
        <img src="assets/sponsors/obsidianprincess.png" width="1254" height="1254" alt="Obsidian Princess — a crowned silver eagle, red lightning and the Obsidian Legion name" decoding="async">
      </a>
      <div class="hosting-video-wrap">
        <video id="hosting-film" class="hosting-film" muted playsinline loop controls preload="metadata" poster="assets/hosting-poster.jpg" aria-label="Obsidian Princess hosting sponsor video: the Legion eagle over Saskatchewan">
          <source src="assets/hosting-sponsor.mp4" type="video/mp4">
        </video>
      </div>
    </section>
    <p id="playback-status" class="sr-only" role="status" aria-live="polite"></p>
  </main>
  """

campaign.footer : Text
campaign.footer =
  """
  <footer class="footer">
    <span class="footer-note">FORGED IN OBSIDIAN.</span>
    <div class="playback-controls" id="playback-controls" role="group" aria-label="Presentation controls" hidden>
      <button id="sound-toggle" type="button" aria-label="Enable sound" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z"/><path class="sound-off-mark" d="m16 9 5 6m0-6-5 6"/><path class="sound-on-mark" d="M16 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/></svg><span>Sound off</span></button>
      <button id="motion-toggle" type="button" aria-label="Pause motion" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="pause-mark" d="M9 5v14M15 5v14"/><path class="play-mark" d="m8 5 11 7-11 7V5Z"/></svg><span>Pause motion</span></button>
      <button id="replay" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 8M4 4v6h6"/></svg><span>Replay intro</span></button>
    </div>
    <span class="footer-signature">GRONLID LIBRARY CAMPAIGN <span aria-hidden="true">◆</span></span>
  </footer>
  <noscript><style>.intro-caption{display:none}.cinema{pointer-events:none}</style></noscript>
  </body>
  </html>
  """

campaign.document : Text
campaign.document =
  campaign.head "Keep Gronlid Library Open — Obsidian Legion"
    "An Obsidian Legion sponsored campaign to keep Gronlid Public Library open in Saskatchewan, Canada." "opening-page"
    ++ campaign.header ++ campaign.stage ++ campaign.footer

campaign.main : '{IO, Exception} ()
campaign.main = do printLine campaign.document

-- The sponsor roster and badge markup are generated by Unison.
structural type CampaignSponsor = CampaignSponsor Text Text Text

campaign.sponsors : [CampaignSponsor]
campaign.sponsors =
  [ CampaignSponsor "Eaglescrest" "eaglescrest" "A crowned silver eagle with a red-lit obsidian crest"
  , CampaignSponsor "AviatorsBane" "aviatorsbane" "An aviator skull with goggles, wings, and a propeller"
  , CampaignSponsor "DarkSummit" "darksummit" "Jagged mountain peaks crossed by glowing red fissures"
  , CampaignSponsor "ZeroHour" "zerohour" "A silver Z over a red-lit clock face"
  , CampaignSponsor "Dradean" "dradean" "A horned dragon with spread wings and glowing red eyes"
  , CampaignSponsor "ObsidianFlame" "obsidianflame" "A silver phoenix with sweeping red flames"
  , CampaignSponsor "FiniteDestruction" "finitedestruction" "Silver FD initials surrounded by shattered obsidian and red lightning"
  , CampaignSponsor "GreyWolf" "greywolf" "A crowned silver wolf with glowing red eyes"
  ]

campaign.sponsorBadge : CampaignSponsor -> Text
campaign.sponsorBadge sponsor =
  match sponsor with
    CampaignSponsor name slug description ->
      "<li class=\"sponsor-card\"><figure><a class=\"sponsor-art\" href=\"assets/sponsors/" ++ slug ++ ".png\" target=\"_blank\" rel=\"noopener\" aria-label=\"View " ++ campaign.escape name ++ " badge at full size (opens in a new tab)\">"
        ++ "<img src=\"assets/sponsors/" ++ slug ++ ".png\" alt=\"" ++ campaign.escape description ++ "\" width=\"1254\" height=\"1254\" loading=\"lazy\" decoding=\"async\">"
        ++ "<span class=\"badge-expand\" aria-hidden=\"true\">VIEW BADGE ↗</span></a><figcaption><span>" ++ campaign.escape name ++ "</span><span class=\"sponsor-label\">LEGION SPONSOR</span></figcaption></figure></li>"

campaign.sponsorsHeader : Text
campaign.sponsorsHeader =
  """
  <header class="sponsors-masthead">
    <a class="back-to-campaign" href="index.html"><span aria-hidden="true">←</span> THE CAMPAIGN</a>
    <span class="sponsors-wordmark">OBSIDIAN <span>LEGION</span></span>
    <span class="chapter-marker">02 / SPONSORS</span>
  </header>
  """

campaign.sponsorsBody : Text
campaign.sponsorsBody =
  """
  <main id="campaign" class="sponsors-main" tabindex="-1">
    <section class="sponsors-introduction" aria-labelledby="sponsors-title">
      <div class="sponsors-heading">
        <p class="chapter-eyebrow">THE GRONLID LIBRARY CAMPAIGN</p>
        <h1 id="sponsors-title">Legion sponsors<span>.</span></h1>
        <p class="sponsors-description">A Legion campaign needs at least <strong>three sponsors</strong> to move forward. <strong>Eight sponsors</strong> stepped forward for Gronlid Public Library.</p>
      </div>
      <dl class="sponsorship-count"><div><dt>REQUIRED</dt><dd>03</dd></div><div><dt>THIS CAMPAIGN</dt><dd>08</dd></div></dl>
    </section>
    <div class="sponsors-divider"><span>THE EIGHT SPONSORS</span><i aria-hidden="true"></i><span>OBSIDIAN LEGION</span></div>
    <ul class="sponsor-gallery" aria-label="Eight Legion campaign sponsors">
  """
    ++ Text.join "\n" (List.map campaign.sponsorBadge campaign.sponsors)
    ++ """
    </ul>
    <nav class="sponsors-return" aria-label="Campaign chapters"><a href="index.html"><span aria-hidden="true">←</span> Back to the campaign</a></nav>
    <p id="playback-status" class="sr-only" role="status" aria-live="polite"></p>
  </main>
  """

campaign.sponsorsDocument : Text
campaign.sponsorsDocument =
  campaign.head "Legion Sponsors — Gronlid Library Campaign"
    "A Legion campaign needs at least three sponsors. Meet the eight sponsors behind the Gronlid Public Library campaign." "sponsors-page"
    ++ campaign.sponsorsHeader ++ campaign.sponsorsBody ++ campaign.footer

campaign.sponsorsMain : '{IO, Exception} ()
campaign.sponsorsMain = do printLine campaign.sponsorsDocument

campaign.explanationHeader : Text
campaign.explanationHeader =
  """
  <header class="sponsors-masthead">
    <a class="back-to-campaign" href="sponsors.html"><span aria-hidden="true">←</span> LEGION SPONSORS</a>
    <span class="sponsors-wordmark">OBSIDIAN <span>LEGION</span></span>
    <span class="chapter-marker">03 / THE CAUSE</span>
  </header>
  """

campaign.explanationBody : Text
campaign.explanationBody =
  """
  <main id="campaign" class="explanation-main" tabindex="-1">
    <section class="cause-hero" aria-labelledby="cause-title">
      <div class="cause-opening">
        <p class="chapter-eyebrow">GRONLID · SASKATCHEWAN · CANADA</p>
        <h1 id="cause-title">Keep the<br>doors <em>open.</em></h1>
        <p class="cause-lead">The petition asks Wapiti Regional Library and the Saskatchewan government to pause Gronlid Public Library’s planned December 2026 closure and work with residents on ways to keep it open.</p>
        <p class="cause-organizer">A community petition by <span>What’sUP Choiceland.</span></p>
        <a class="petition-link" href="https://www.openpetition.org/ca/petition/online/stop-the-closure-of-the-gronlid-library" target="_blank" rel="noopener noreferrer">Read and sign the petition <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      </div>
      <div class="cause-emblem" aria-label="Obsidian Legion stands with Gronlid">
        <div class="crest-halo" aria-hidden="true"></div>
        <div class="video-shell">
          <video id="legion-film" class="legion-film" muted playsinline preload="auto" poster="assets/legion-poster.jpg" aria-label="Animated Obsidian Legion eagle crest with red lightning">
            <source src="assets/legion-intro.mp4" type="video/mp4">
          </video>
          <span class="cinema-vignette" aria-hidden="true"></span>
        </div>
        <p class="cause-emblem-caption"><span aria-hidden="true">◆</span> EIGHT SPONSORS. ONE CAMPAIGN.</p>
      </div>
    </section>

    <nav class="cause-jump-links" aria-label="On this page">
      <a href="#the-issue">The issue</a><a href="#importance-title">Local access</a><a href="#requests-title">The requests</a><a href="#take-part">Take part</a><a href="#corporate-sponsorship">Corporate sponsorship <span aria-hidden="true">↓</span></a>
    </nav>
    <div class="cause-divider" aria-hidden="true"><span></span><i></i><span></span></div>

    <section id="the-issue" class="cause-background" aria-labelledby="background-title">
      <div>
        <p class="chapter-eyebrow">THE WIDER PICTURE</p>
        <h2 id="background-title">A local library.<br>A regional challenge.</h2>
      </div>
      <div class="cause-copy">
        <p>In its 12 November 2026 report, 980 CJME identified Gronlid among six communities affected by Wapiti’s planned branch closures: Alvena, Gronlid, Mistatim, Pilger, Prairie River and Saint Benedict.</p>
        <p>Wapiti’s director and CEO, Tony Murphy, told CJME that escalating operating costs and insufficient provincial funding had forced difficult choices across the regional system. He described the closures as a decision about the long-term finances of the whole region.</p>
        <p>The Ministry of Education told CJME that Wapiti’s provincial allocation rose from $953,890 in 2025–26 to $977,343 in 2026–27, and that provincial grants go to regional systems rather than individual branches.</p>
        <p>That sets up the central issue for this campaign: how to keep local access available while addressing the cost of providing it. A lasting solution needs a workable operating plan as well as community support.</p>
        <a class="source-link" href="https://www.cjme.com/2026/11/12/saskatchewan-library-closures-raise-concerns-over-funding/" target="_blank" rel="noopener noreferrer">Read the reporting · 980 CJME, 12 November 2026 <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <div class="cause-details">
      <section class="cause-importance" aria-labelledby="importance-title">
        <p class="chapter-eyebrow">WHAT’S AT STAKE</p>
        <h2 id="importance-title">A library is part<br>of everyday life.</h2>
        <p>The organizers describe a place for books, early reading, computers, internet access and community connection. They warn that closure would force families, students and seniors to travel farther for those services.</p>
        <p>Their concerns include insufficient time to explore alternatives and continued regional library contributions after the local branch closes.</p>
      </section>

      <section class="cause-requests" aria-labelledby="requests-title">
        <p class="chapter-eyebrow">THE PETITION’S REQUESTS</p>
        <h2 id="requests-title">A way forward.</h2>
        <ol class="request-list">
          <li><span class="request-number" aria-hidden="true">01</span><div><h3>Pause the closure.</h3><p>Put the December shutdown on hold and allow time to consider a sustainable plan for the branch.</p></div></li>
          <li><span class="request-number" aria-hidden="true">02</span><div><h3>Work with Gronlid.</h3><p>Bring residents, the local library board and municipal leaders into transparent discussions about fundraising, partnerships and possible changes to opening hours.</p></div></li>
          <li><span class="request-number" aria-hidden="true">03</span><div><h3>Make rural funding sustainable.</h3><p>Review provincial funding so rural branches have support that reflects inflation and the rising cost of delivering library services.</p></div></li>
        </ol>
      </section>
    </div>

    <section class="legion-backing" aria-labelledby="backing-title">
      <div class="backing-count" aria-hidden="true">08<span>CAMPAIGN SPONSORS</span></div>
      <div class="cause-copy">
        <p class="chapter-eyebrow">BACKED BY THE LEGION</p>
        <h2 id="backing-title">Standing with Gronlid.</h2>
        <p>Eight members stepped forward to sponsor this campaign, exceeding the three-sponsor requirement. Obsidian Princess is our hosting sponsor. This site brings those supporters together around one shared aim: keeping attention on Gronlid’s library and helping visitors reach the community petition.</p>
        <a class="source-link" href="sponsors.html">Meet the Legion sponsors <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section id="take-part" class="cause-action" aria-labelledby="action-title">
      <p class="chapter-eyebrow">STAND WITH GRONLID</p>
      <h2 id="action-title">Make your support count.</h2>
      <p class="action-intro">Start with the petition, then help someone else understand why this campaign matters.</p>
      <ol class="support-steps">
        <li><span class="step-label">01 / ADD YOUR VOICE</span><h3>Read and sign.</h3><p>Read the full petition on openPetition. If you support its requests, add your name there so your support reaches the organizers.</p></li>
        <li><span class="step-label">02 / SPREAD THE WORD</span><h3>Share the source.</h3><p>Send the petition to friends, family and community groups. Include a short explanation of why a local library matters to you.</p></li>
        <li><span class="step-label">03 / MAKE IT PERSONAL</span><h3>Tell your story.</h3><p>A specific example can make the issue easier to understand: a book that helped a child learn, access to a computer, or a conversation that made someone feel welcome. Share your own experience in the petition’s comments.</p></li>
      </ol>
      <a class="petition-link" href="https://www.openpetition.org/ca/petition/online/stop-the-closure-of-the-gronlid-library" target="_blank" rel="noopener noreferrer">Stand with Gronlid — view the petition <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
    </section>

    <section id="corporate-sponsorship" class="corporate-section" aria-labelledby="corporate-title">
      <div class="corporate-introduction cause-copy">
        <p class="chapter-eyebrow">FOR COMPANIES &amp; LOCAL BUSINESSES</p>
        <h2 id="corporate-title">Put your business<br>behind Gronlid.</h2>
        <p>Interested in financial support, materials or professional services? Describe what your company could offer and start a conversation with Wapiti Regional Library about supporting the Gronlid branch.</p>
        <p>Ask the library about current needs and any sponsorship terms.</p>
        <div class="corporate-contact">
          <span class="step-label">YOUR REQUEST IS ADDRESSED TO</span>
          <h3>Wapiti Regional Library</h3>
          <p>Regional office · Gronlid branch inquiry</p>
          <a id="corporate-recipient" href="mailto:wapiti@wapitilibrary.ca">wapiti@wapitilibrary.ca</a>
          <a class="source-link" href="https://sk.211.ca/services/9734738/agency/wapiti-regional-library/" target="_blank" rel="noopener noreferrer">Contact listed by 211 Saskatchewan <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="corporate-request">
        <form id="corporate-form" aria-label="Corporate sponsorship inquiry" aria-describedby="corporate-form-help" hidden>
          <p id="corporate-form-help" class="form-help">Prepare a request to support Gronlid Public Library. Fields marked * are required.</p>
          <div class="corporate-fields">
            <label for="corporate-company">Company name *<input id="corporate-company" name="company" autocomplete="organization" required maxlength="100"></label>
            <label for="corporate-name">Contact name *<input id="corporate-name" name="contact" autocomplete="name" required maxlength="100"></label>
            <label for="corporate-email">Work email *<input id="corporate-email" name="email" type="email" autocomplete="email" required maxlength="160"></label>
            <label for="corporate-phone">Phone <span>(optional)</span><input id="corporate-phone" name="phone" type="tel" autocomplete="tel" maxlength="40"></label>
            <label for="corporate-support">Proposed support *<select id="corporate-support" name="support" required><option value="">Select an option</option><option>Financial sponsorship</option><option>Materials or professional services</option><option>Employee fundraising or matching</option><option>Discuss available options</option></select></label>
            <label for="corporate-budget">Proposed amount / value <span>(optional)</span><input id="corporate-budget" name="budget" placeholder="e.g. CAD 1,000 or to be discussed" maxlength="80"></label>
            <label class="field-full" for="corporate-message">What would you like to offer? *<textarea id="corporate-message" name="message" rows="5" required maxlength="1500" placeholder="Tell the library about your proposed support, timing and any questions."></textarea></label>
          </div>
          <p class="form-help">This form prepares an email; it does not send or store your request. You review and send it from your email app.</p>
          <button class="petition-link" type="submit">Prepare sponsorship request <span aria-hidden="true">↗</span></button>
        </form>
        <noscript><p class="form-help">Email the regional office using the address shown. Include your company name, contact details and proposed support for Gronlid Public Library.</p></noscript>
        <section id="corporate-draft" class="corporate-draft" aria-labelledby="draft-title" hidden>
          <h3 id="draft-title" tabindex="-1">Your sponsorship request</h3>
          <label for="corporate-preview">Email preview<textarea id="corporate-preview" rows="13" readonly></textarea></label>
          <div class="draft-actions"><a id="corporate-mailto" class="petition-link">Open email draft <span aria-hidden="true">↗</span></a><button id="corporate-copy" type="button">Copy request</button></div>
          <p class="form-help">Send the email from your email app. If no app opens, copy the request into a new email to the address above.</p>
        </section>
        <p id="corporate-status" class="form-status" role="status" aria-live="polite"></p>
      </div>
    </section>
    <script src="sponsorship.js?v=1" defer></script>

    <aside class="cause-source" aria-label="Source of the campaign explanation">
      <p>Petition: <cite><a href="https://www.openpetition.org/ca/petition/online/stop-the-closure-of-the-gronlid-library" target="_blank" rel="noopener noreferrer">Stop the Closure of the Gronlid Library</a></cite> by What’sUP Choiceland. Regional background: <a href="https://www.cjme.com/2026/11/12/saskatchewan-library-closures-raise-concerns-over-funding/" target="_blank" rel="noopener noreferrer">980 CJME’s reporting</a>.</p>
      <p>Reviewed <time datetime="2026-11-17">17 November 2026</time>.</p>
    </aside>
    <nav class="cause-navigation" aria-label="Campaign chapters"><a href="sponsors.html"><span aria-hidden="true">←</span> The eight Legion sponsors</a></nav>
    <p id="playback-status" class="sr-only" role="status" aria-live="polite"></p>
  </main>
  """

campaign.explanationDocument : Text
campaign.explanationDocument =
  campaign.head "Keep Gronlid Library Open — The Campaign"
    "Why Gronlid Public Library matters, and what the community petition asks Wapiti Regional Library and the province to do." "explanation-page"
    ++ campaign.explanationHeader ++ campaign.explanationBody ++ campaign.footer

campaign.explanationMain : '{IO, Exception} ()
campaign.explanationMain = do printLine campaign.explanationDocument
