-- Unison owns the document, accessible controls, and page composition.
-- CSS and a small browser enhancement provide the cinematic presentation.
use Text ++

campaign.escape : Text -> Text
campaign.escape value =
  value
    |> Text.replaceAll "&" "&amp;"
    |> Text.replaceAll "<" "&lt;"
    |> Text.replaceAll ">" "&gt;"
    |> Text.replaceAll "\"" "&quot;"

campaign.head : Text -> Text -> Text -> Text
campaign.head title description pageClass =
  """
  <!doctype html>
  <html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#000000">
    <title>{{title}}</title>
    <meta name="description" content="{{description}}">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{description}}">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://obsidian-legion.github.io/campaignlegionlibrary/assets/gronlid-library-banner.png">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="styles.css?v=sponsors-1">
    <script src="site.js?v=sponsors-1" defer></script>
  </head>
  <body class="{{pageClass}}">
    <a class="skip-link" href="#campaign">Skip to content</a>
    <canvas id="embers" aria-hidden="true"></canvas>
    <div class="ambient" aria-hidden="true"></div>
    <div class="edge edge-left" aria-hidden="true"></div>
    <div class="edge edge-right" aria-hidden="true"></div>
  """
    |> Text.replaceAll "{{title}}" (campaign.escape title)
    |> Text.replaceAll "{{description}}" (campaign.escape description)
    |> Text.replaceAll "{{pageClass}}" (campaign.escape pageClass)

campaign.header : Text
campaign.header =
  """
  <header class="campaign-masthead" aria-label="Obsidian Legion sponsored campaign for Gronlid Public Library">
    <div class="campaign-banner">
      <div class="banner-art">
        <img src="assets/gronlid-library-banner.png" alt="Obsidian Legion sponsored campaign — Gronlid Public Library, Gronlid, Saskatchewan, Canada" width="2172" height="724" fetchpriority="high">
        <div class="banner-shine" aria-hidden="true"></div>
      </div>
    </div>
    <div class="cinema" id="cinema">
      <div class="crest-halo" aria-hidden="true"></div>
      <div class="video-shell">
        <video id="legion-film" class="legion-film" muted playsinline preload="auto" poster="assets/legion-poster.jpg" aria-label="Animated Obsidian Legion eagle crest, with outstretched wings, smoke, and red lightning">
          <source src="assets/legion-intro.mp4" type="video/mp4">
        </video>
        <span class="cinema-vignette" aria-hidden="true"></span>
      </div>
      <div class="intro-caption" aria-hidden="true"><span></span> OBSIDIAN LEGION PRESENTS <span></span></div>
      <button class="skip-intro" id="skip-intro" type="button" hidden>Skip intro <span aria-hidden="true">↗</span></button>
      <div class="intro-progress" aria-hidden="true"><span></span></div>
    </div>
    <div class="banner-rule" aria-hidden="true"><span></span><i></i><span></span></div>
  </header>
  """

campaign.stage : Text
campaign.stage =
  """
  <main id="campaign" tabindex="-1">
    <h1 class="sr-only">Gronlid Public Library — Obsidian Legion campaign</h1>
    <nav class="opening-navigation" aria-label="Campaign chapters">
      <a class="next-chapter" href="sponsors.html"><span class="chapter-eyebrow">NEXT CHAPTER / 02</span><span class="chapter-name">Legion sponsors <span aria-hidden="true">→</span></span><span class="chapter-detail">Meet the six behind this campaign.</span></a>
    </nav>
    <p id="playback-status" class="sr-only" role="status" aria-live="polite"></p>
  </main>
  """

campaign.footer : Text
campaign.footer =
  """
  <footer class="footer">
    <span class="footer-note">FORGED IN OBSIDIAN.</span>
    <div class="playback-controls" id="playback-controls" role="group" aria-label="Presentation controls" hidden>
      <button id="sound-toggle" type="button" aria-label="Enable sound" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z"/><path class="sound-off-mark" d="m16 9 5 6m0-6-5 6"/><path class="sound-on-mark" d="M16 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/></svg><span>Sound off</span></button>
      <button id="motion-toggle" type="button" aria-label="Pause motion" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="pause-mark" d="M9 5v14M15 5v14"/><path class="play-mark" d="m8 5 11 7-11 7V5Z"/></svg><span>Pause motion</span></button>
      <button id="replay" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 8M4 4v6h6"/></svg><span>Replay intro</span></button>
    </div>
    <span class="footer-signature">GRONLID LIBRARY CAMPAIGN <span aria-hidden="true">◆</span></span>
  </footer>
  <noscript><style>.intro-caption{display:none}.cinema{pointer-events:none}</style></noscript>
  </body>
  </html>
  """

campaign.document : Text
campaign.document =
  campaign.head "Keep Gronlid Library Open — Obsidian Legion"
    "An Obsidian Legion sponsored campaign to keep Gronlid Public Library open in Saskatchewan, Canada." "opening-page"
    ++ campaign.header ++ campaign.stage ++ campaign.footer

campaign.main : '{IO, Exception} ()
campaign.main = do printLine campaign.document

-- The sponsor roster and badge markup are generated by Unison.
structural type CampaignSponsor = CampaignSponsor Text Text Text

campaign.sponsors : [CampaignSponsor]
campaign.sponsors =
  [ CampaignSponsor "Eaglescrest" "eaglescrest" "A crowned silver eagle with a red-lit obsidian crest"
  , CampaignSponsor "AviatorsBane" "aviatorsbane" "An aviator skull with goggles, wings, and a propeller"
  , CampaignSponsor "DarkSummit" "darksummit" "Jagged mountain peaks crossed by glowing red fissures"
  , CampaignSponsor "ZeroHour" "zerohour" "A silver Z over a red-lit clock face"
  , CampaignSponsor "Dradean" "dradean" "A horned dragon with spread wings and glowing red eyes"
  , CampaignSponsor "ObsidianFlame" "obsidianflame" "A silver phoenix with sweeping red flames"
  ]

campaign.sponsorBadge : CampaignSponsor -> Text
campaign.sponsorBadge sponsor =
  match sponsor with
    CampaignSponsor name slug description ->
      "<li class=\"sponsor-card\"><figure><a class=\"sponsor-art\" href=\"assets/sponsors/" ++ slug ++ ".png\" target=\"_blank\" rel=\"noopener\" aria-label=\"View " ++ campaign.escape name ++ " badge at full size (opens in a new tab)\">"
        ++ "<img src=\"assets/sponsors/" ++ slug ++ ".png\" alt=\"" ++ campaign.escape description ++ "\" width=\"1254\" height=\"1254\" loading=\"lazy\" decoding=\"async\">"
        ++ "<span class=\"badge-expand\" aria-hidden=\"true\">VIEW BADGE ↗</span></a><figcaption><span>" ++ campaign.escape name ++ "</span><span class=\"sponsor-label\">LEGION SPONSOR</span></figcaption></figure></li>"

campaign.sponsorsHeader : Text
campaign.sponsorsHeader =
  """
  <header class="sponsors-masthead">
    <a class="back-to-campaign" href="index.html"><span aria-hidden="true">←</span> THE CAMPAIGN</a>
    <span class="sponsors-wordmark">OBSIDIAN <span>LEGION</span></span>
    <span class="chapter-marker">02 / SPONSORS</span>
  </header>
  """

campaign.sponsorsBody : Text
campaign.sponsorsBody =
  """
  <main id="campaign" class="sponsors-main" tabindex="-1">
    <section class="sponsors-introduction" aria-labelledby="sponsors-title">
      <div class="sponsors-heading">
        <p class="chapter-eyebrow">THE GRONLID LIBRARY CAMPAIGN</p>
        <h1 id="sponsors-title">Legion sponsors<span>.</span></h1>
        <p class="sponsors-description">A Legion campaign needs at least <strong>three sponsors</strong> to move forward. <strong>Six sponsors</strong> stepped forward for Gronlid Public Library.</p>
      </div>
      <dl class="sponsorship-count"><div><dt>REQUIRED</dt><dd>03</dd></div><div><dt>THIS CAMPAIGN</dt><dd>06</dd></div></dl>
    </section>
    <div class="sponsors-divider"><span>THE SIX SPONSORS</span><i aria-hidden="true"></i><span>OBSIDIAN LEGION</span></div>
    <ul class="sponsor-gallery" aria-label="Six Legion campaign sponsors">
  """
    ++ Text.join "\n" (List.map campaign.sponsorBadge campaign.sponsors)
    ++ """
    </ul>
    <nav class="sponsors-return" aria-label="Campaign chapters"><a href="index.html"><span aria-hidden="true">←</span> Back to the campaign</a></nav>
    <p id="playback-status" class="sr-only" role="status" aria-live="polite"></p>
  </main>
  """

campaign.sponsorsDocument : Text
campaign.sponsorsDocument =
  campaign.head "Legion Sponsors — Gronlid Library Campaign"
    "A Legion campaign needs at least three sponsors. Meet the six sponsors behind the Gronlid Public Library campaign." "sponsors-page"
    ++ campaign.sponsorsHeader ++ campaign.sponsorsBody ++ campaign.footer

campaign.sponsorsMain : '{IO, Exception} ()
campaign.sponsorsMain = do printLine campaign.sponsorsDocument
